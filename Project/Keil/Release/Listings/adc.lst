 124          /**
 125           * @brief 切换 adc0 的通道
 126           * @attention 函数内部没有延时等待adc稳定，调用时需要注意
 127           *
 128           * @param adc_channel
 129           */
 130          static void adc0_sel_channel(u8 adc_channel)
 131          {
 132   1          switch (adc_channel)
 133   1          {
 134   2          case ADC_CHANNEL_FORWARD:
 135   2              ADC_CHS0 = ADC_ANALOG_CHAN(0x12); // 模拟通道 0x12：P22
 136   2              break;
 137   2          case ADC_CHANNEL_REVERSE:
 138   2              ADC_CHS0 = ADC_ANALOG_CHAN(0x05); // 模拟通道 0x05：P05
 139   2              break;
 140   2          default:
 141   2              break;
 142   2          }
 143   1      }
