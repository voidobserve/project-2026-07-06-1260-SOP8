 176   2              // 开启转换，之后在ad中断获取ad值
 177   2              ADC_CFG0 |= 0x01 << 0; // 开启 adc0 转换
 178   2              adc0_status = ADC_STATUS_SEL_GET_REVERSE;
 179   2          }
 180   1      }
