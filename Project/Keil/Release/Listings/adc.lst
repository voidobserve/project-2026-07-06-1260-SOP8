 145          /**
 146           * @brief adc扫描函数，包含轮询、顺序切换通道和启动转换
 147           * @note 该函数启动ad转换之后，在adc中断服务函数中接收adc值
 148           * @attention 函数内部没有延时等待adc稳定，调用该函数的时间间隔至少要20us，一�
             -��是用1ms
 149           *
 150           */
 151          void adc_scan_1ms_isr(void)
 152          {
 153   1          // printf("adc0_status == %bu\n", adc0_status);
 154   1          // printf("adc1_status == %bu\n", adc1_status);
 155   1      
 156   1          if (adc0_status == ADC_STATUS_NONE || adc0_status == ADC_STATUS_SEL_GET_REVERSE)
 157   1          {
 158   2              // 切换ad通道
 159   2              adc0_sel_channel(ADC_CHANNEL_FORWARD);
 160   2              adc0_status = ADC_STATUS_SEL_GET_FORWARD_WAITING;
 161   2          }
 162   1          else if (adc0_status == ADC_STATUS_SEL_GET_FORWARD_WAITING)
 163   1          {
 164   2              // 开启转换，之后在ad中断获取ad值
 165   2              ADC_CFG0 |= 0x01 << 0; // 开启 adc0 转换
 166   2              adc0_status = ADC_STATUS_SEL_GET_FORWARD;
 167   2          }
 168   1          else if (adc0_status == ADC_STATUS_SEL_GET_FORWARD)
 169   1          {
 170   2              // 切换ad通道
 171   2              adc0_sel_channel(ADC_CHANNEL_REVERSE);
 172   2              adc0_status = ADC_STATUS_SEL_GET_REVERSE_WAITING;
 173   2          }
